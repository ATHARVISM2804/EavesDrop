# Copy to .env.local and fill in. Never commit real secrets.

# --- Supabase ---------------------------------------------------------------
# Project URL + anon key are safe for the browser (RLS enforces access).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: SERVER ONLY. Bypasses RLS — used by ingestion & scoring jobs.
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude API (scoring engine) --------------------------------------------
ANTHROPIC_API_KEY=
# Haiku for first-pass, Sonnet for borderline escalation.
ANTHROPIC_MODEL_FIRST_PASS=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_ESCALATION=claude-sonnet-5

# --- Source APIs ------------------------------------------------------------
# Reddit (script app credentials)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=eavesdrop/0.1 by yourusername
# X / Twitter recent search
X_BEARER_TOKEN=
# Hacker News (Algolia) needs no key.

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# The $49/mo recurring Price (create a Product+Price in Stripe → copy price_...)
STRIPE_PRICE_ID=

# --- Pipeline ---------------------------------------------------------------
# Protects the /api/pipeline trigger (ingest → score). Any long random string.
CRON_SECRET=

# --- Demo mode --------------------------------------------------------------
# true = bypass the paywall (full dashboard access) + use the free heuristic
# scorer when no ANTHROPIC_API_KEY. Turn OFF (unset) for production.
DEMO_MODE=false

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
